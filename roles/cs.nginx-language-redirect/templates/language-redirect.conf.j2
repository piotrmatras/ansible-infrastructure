{% if nginx_language_redirect_detection_method == "geolite2" -%}
geoip2 /usr/share/GeoIP/GeoLite2-Country.mmdb {
  auto_reload 15m;
  $geoip2_data_country_code source=$remote_addr country iso_code;
}
{%- set lang_source_var = "$geoip2_data_country_code" %}
{%- endif %}


{%- if nginx_language_redirect_detection_method == "accept_language" -%}
{%- set lang_source_var = "$first_language" %}
{%- endif %}

{%- if nginx_language_redirect_detection_method == "cloudflare" -%}
{%- set lang_source_var = "$http_cf_ipcountry" %}
{%- endif %}


{% if nginx_language_redirect_style == "dir" %}
map {{ lang_source_var }} $target {
{%- for lang, path in nginx_language_redirect_directory_mapping.items() %}
  {{ lang }} {{ path }};
{%- endfor %}
}
{% endif %}


{% if nginx_language_redirect_style == "domain" -%}
map {{ lang_source_var }} $target {
{%- for lang, domain in nginx_language_redirect_domain_mapping.items() %}
  {{ lang }} {{ domain }};
{%- endfor %}
}
{% endif %}

{% if nginx_language_redirect_cookie_enable | default(false, true) -%}
{%- set cookie_max_age = nginx_language_redirect_cookie_max_age | default('', true) -%}
{%- set cookie_domain = nginx_language_redirect_cookie_domain | default('', true) -%}
{%- set cookie_attrs = "Path=/; Secure; SameSite=Lax" -%}
{%- if cookie_domain %}
{%- set cookie_attrs = cookie_attrs ~ "; Domain=" ~ cookie_domain -%}
{%- endif %}
{%- if cookie_max_age %}
{%- set cookie_attrs = cookie_attrs ~ "; Max-Age=" ~ cookie_max_age -%}
{%- endif %}
# Cookie signal should be emitted only on auto-redirect from root.
# We use maps (not "if") so add_header inheritance stays intact.
# Conditions:
# - request is "/" or "/?" (root)
# - host differs from target (so a redirect will occur)
map $request_uri $nginx_language_redirect_is_root {
  ~^/(\?.*)?$ 1;
  default 0;
}

# Domain-style safety: if host equals target, no redirect, so no cookie.
map "$host:$target" $nginx_language_redirect_host_matches_target {
  ~^([^:]+):\1$ 1;
  default 0;
}

map "$nginx_language_redirect_is_root:$nginx_language_redirect_host_matches_target:$target" $nginx_language_redirect_cookie {
  ~^1:0:.+$ "{{ nginx_language_redirect_cookie_name }}=1; {{ cookie_attrs }}";
  default "";
}
{%- endif %}
